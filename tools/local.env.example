# Copy to tools/local.env (git-ignored). Everything here is optional: with exactly one phone connected the scripts
# find it themselves.

# Android phone (adb serial, from `adb devices`), when several are connected.
# TETHER_ANDROID_SERIAL=R5XXXXXXXXX

# iPhone / iPad for tools/reinstall-ios.sh (UDID, from `xcrun devicectl list devices`), when several are connected.
# TETHER_IOS_DEVICE=00008XXX-XXXXXXXXXXXXXXXX
